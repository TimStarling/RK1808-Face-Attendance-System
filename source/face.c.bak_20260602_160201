static int read_all(int fd, void *buf, size_t size) {
    unsigned char *p = buf;
    size_t total = 0;

    while (total < size) {
        ssize_t n = read(fd, p + total, size - total);
        if (n <= 0) {
            return -1;
        }
        total += n;
    }

    return 0;
}

